{
  "appId": "com.verboeterno.app",
  "appName": "Verbo Eterno",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#0c0a08"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0c0a08",
      "showSpinner": false
    }
  }
}
